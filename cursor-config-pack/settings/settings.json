{
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.tabSize": 2,
  "editor.tabCompletion": "on",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "workbench.fontAliasing": "antialiased",
  "window.title": "${activeEditorMedium}${separator}${rootName}",
  "terminal.external.osxExec": "iTerm.app",
  "terminal.integrated.confirmOnExit": "hasChildProcesses",
  "git.autoStash": true,
  "git.showPushSuccessNotification": true,
  "typescript.locale": "zh-CN",
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.renderWhitespace": "all",
  "editor.renderControlCharacters": false,
  "editor.minimap.showSlider": "always",
  "editor.minimap.renderCharacters": false,
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "gulp.autoDetect": "off",
  "grunt.autoDetect": "off",
  "psi-header.config": {
    "forceToTop": true,
    "blankLinesAfter": 1,
    "author": "dengjiayao",
    "authorEmail": "dengjiayao@yzw.cn",
  },
  "psi-header.templates": [
    {
      "language": "*",
      "template": [
        "@Date: <<filecreated('YYYY-MM-DD HH:mm:ss')>>",
        "@Author: <<author>>",
        "-----",
        "@Description: ",
      ],
    },
  ],
  "psi-header.changes-tracking": {
    "isActive": true,
    "autoHeader": "manualSave",
    "modAuthor": "@Last Modified by:",
    "modDate": "@Last Modified time:",
    "modDateFormat": "YYYY-MM-DD HH:mm:ss",
    "exclude": ["css", "less"],
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
  ],
  "workbench.iconTheme": "material-icon-theme",
  "editor.suggest.shareSuggestSelections": true,
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features",
  },
  "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "files.autoSave": "off",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "never",
    "source.fixAll.stylelint": "explicit",
  },
  "search.exclude": {
    "**/dist": true,
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "files.associations": {
    "*.acss": "css",
    "*.json": "jsonc",
  },
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "workbench.startupEditor": "none",
  "editor.suggestSelection": "first",
  "security.workspace.trust.untrustedFiles": "open",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.foldingMaximumRegions": 10000,
  "[markdown]": {
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "editor.wordWrap": "on",
  },
  "prettier.singleQuote": true,
  "typescript.preferences.quoteStyle": "double",
  "npm.packageManager": "pnpm",
  "js/ts.implicitProjectConfig.target": "ESNext",
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.quickSuggestions": {
    "comments": "on",
    "strings": "on",
  },
  "editor.suggest.insertMode": "replace",
  "editor.suggest.preview": true,
  "javascript.referencesCodeLens.showOnAllFunctions": true,
  "[xml]": {
    "editor.defaultFormatter": "DotJoshJohnson.xml",
  },
  "editor.fontSize": 14,
  "editor.accessibilitySupport": "off",
  "editor.minimap.enabled": false,
  "workbench.editor.tabSizingFixedMaxWidth": 256,
  "workbench.editor.tabSizingFixedMinWidth": 64,
  "update.showReleaseNotes": false,
  "git.enableSmartCommit": true,
  "files.eol": "\n",
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "never",
  "diffEditor.ignoreTrimWhitespace": false,
  "markdown.preview.scrollEditorWithPreview": false,
  "diffEditor.wordWrap": "off",
  "indentRainbow.indicatorStyle": "light",
  "breadcrumbs.showVariables": false,
  "breadcrumbs.showTypeParameters": false,
  "breadcrumbs.showStructs": false,
  "breadcrumbs.showStrings": false,
  "breadcrumbs.showProperties": false,
  "breadcrumbs.showPackages": false,
  "breadcrumbs.showOperators": false,
  "breadcrumbs.showObjects": false,
  "breadcrumbs.showNumbers": false,
  "breadcrumbs.showNull": false,
  "breadcrumbs.showNamespaces": false,
  "breadcrumbs.showModules": false,
  "breadcrumbs.showMethods": false,
  "breadcrumbs.showKeys": false,
  "breadcrumbs.showInterfaces": false,
  "breadcrumbs.showFunctions": false,
  "breadcrumbs.showFiles": false,
  "breadcrumbs.showFields": false,
  "breadcrumbs.showEvents": false,
  "breadcrumbs.showEnums": false,
  "breadcrumbs.showEnumMembers": false,
  "breadcrumbs.showConstructors": false,
  "breadcrumbs.showConstants": false,
  "breadcrumbs.showClasses": false,
  "breadcrumbs.showBooleans": false,
  "breadcrumbs.showArrays": false,
  "breadcrumbs.symbolPath": "off",
  "breadcrumbs.enabled": false,
  "php.validate.enable": false,
  "php.suggest.basic": false,
  "[plaintext]": {
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
  },
  "auto-rename-tag.activationOnLanguage": ["*"],
  "turboConsoleLog.quote": "`",
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "psi-header.license-reference": {},
  "window.autoDetectColorScheme": false,
  "workbench.colorTheme": "One Dark Pro Mix",
  "mermaidChart.showGenerateDiagramCodeLens": false,
  "prettier.proseWrap": "never",
  "git.blame.editorDecoration.enabled": true,
  "git.blame.ignoreWhitespace": true,
}
